# Flask
SECRET_KEY=change-me-to-a-long-random-string

# MinIO / S3 (same instance as before — bucket/data stays intact)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=datalakev3
MINIO_SECURE=false

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=lakehouse
PG_USER=lakehouse
PG_PASSWORD=lakehouse

# Spark: "local" (pandas, no cluster needed) or "cluster" (real PySpark)
SPARK_MODE=local
SPARK_MASTER_URL=spark://localhost:7077

# Used ONLY by `docker compose up` to create the first Administrator
# automatically (via the one-off "seed" service). Change the password
# before you run this for real, then it's safe to leave these here —
# re-running seed is a no-op once the account exists.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_FULL_NAME=Workspace Admin
